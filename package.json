{
  "name": "@local/game-bench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Game Bench (拾光游戏厅) — a DeepSeek Harness plugin: a left-sidebar retro console that plays NES games in the browser (jsnes 2.1.0, 60fps, saves, CRT filter, gamepad), ships an original demo ROM, and includes its own game market backed by the zeelinkCN/game-bench-library catalog.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon-256.png"
  },
  "files": [
    ".gitignore",
    "LICENSE",
    "README.md",
    "BUILTIN-GAMES.md",
    "client.js",
    "cordis.patch.yml",
    "engine.js",
    "index.js",
    "assets/*.png",
    "games/builtin.json",
    "games/*.nes",
    "games/*.png",
    "locale/*.json",
    "server/*.mjs",
    "vendor/jsnes.min.js",
    "vendor/LICENSE-jsnes.txt",
    "games/builtin.local.json",
    "games/starpilot.nes",
    "games/starpilot.png",
    "engine.selftest.mjs",
    "server/selftest.mjs",
    "scripts/*.mjs",
    "selftest/*.mjs",
    "selftest/harness.html",
    "selftest/README.md",
    "selftest/assets/*.js",
    "docs/*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "deepseek",
    "dsh-plugin",
    "game-bench",
    "nes",
    "famicom",
    "emulator",
    "jsnes",
    "retro-games",
    "game-market",
    "plugin",
    "macos",
    "windows"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeelinkCN/dsh-game-bench.git"
  },
  "homepage": "https://github.com/zeelinkCN/dsh-game-bench",
  "bugs": {
    "url": "https://github.com/zeelinkCN/dsh-game-bench/issues"
  }
}